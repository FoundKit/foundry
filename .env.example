# ==============================================================================
# FOUNDRY PLATFORM CONFIGURATION
# ==============================================================================

# Database Connection URL (Automatically routes by protocol: postgres:// or mysql://)
# PostgreSQL:
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/foundry
# Or MySQL / MariaDB:
# DATABASE_URL=mysql://root:root@localhost:3306/foundry

# Optional Redis Connection String
REDIS_URL=redis://127.0.0.1:6379

# JWT Secret Key for Admin Authentication
JWT_SECRET=foundry_dev_super_secret_jwt_key_2026

# Server Host & Port
HOST=127.0.0.1
PORT=8080

# Auto-run baseline migrations on startup
AUTO_MIGRATE=true

# Logging Level
RUST_LOG=info,foundry_server=debug,foundry_engine=debug
