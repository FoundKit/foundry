# ==============================================================================
# FOUNDRY PLATFORM CONFIGURATION
# ==============================================================================

# Database Connection URL (Auto-detected by protocol prefix or DATABASE_TYPE)
# PostgreSQL:
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/foundry
# MySQL:
# DATABASE_URL=mysql://root:root@localhost:3306/foundry
# MariaDB:
# DATABASE_URL=mariadb://root:root@localhost:3307/foundry
# MongoDB:
# DATABASE_URL=mongodb://127.0.0.1:27017/foundry

# Optional Database SSL/TLS Mode (disabled | preferred | required | verify_ca | verify_identity)
# Default is 'preferred'. In private VPC/internal Docker networks with legacy self-signed certificates,
# set DATABASE_SSL_MODE=disabled to enforce unencrypted connections.
# DATABASE_SSL_MODE=preferred

# Optional Redis Connection String
REDIS_URL=redis://127.0.0.1:6379

# JWT Secret Key for Admin Authentication
JWT_SECRET=foundry_dev_super_secret_jwt_key_2026

# Server Host & Port
HOST=127.0.0.1
PORT=8080

# Auto-run baseline migrations on startup
AUTO_MIGRATE=true

# Optional SMTP Email Service Configuration
# If not configured, email functions (e.g. login code, email binding) are disabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Foundry <no-reply@foundry.local>

# Logging Level
RUST_LOG=info,foundry_server=debug,foundry_engine=debug

